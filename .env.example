# --- app ---
SECRET_KEY=

# --- banco compartilhado (usado pelos dois serviços) ---
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=

PORT=5000

# URL pública do app -- usada pra montar o link do e-mail de "esqueci
# minha senha" e o link dos convites da equipe (ex: https://seu-subdominio.lapps.studio)
PUBLIC_APP_URL=

# --- serviço de autenticação (auth) ---
# Em produção o app chama o auth pelo nome do serviço na rede interna
# do Docker (ver docker-compose.yml); isso não é segredo, mas fica aqui
# pra rodar localmente com docker-compose.dev.yml.
AUTH_SERVICE_URL=http://auth:5001

# --- serviço de logs (log) ---
# Mesmo esquema do auth: nome do serviço na rede interna do Docker.
LOG_SERVICE_URL=http://log:5002

# --- object storage (Garage) ---
# O Garage cria o bucket e a chave no primeiro boot a partir desses valores.
# Gerar com:
#   S3_ACCESS_KEY:     echo GK$(openssl rand -hex 12)
#   S3_SECRET_KEY:     openssl rand -hex 32
#   GARAGE_RPC_SECRET: openssl rand -hex 32
S3_BUCKET=receitas
S3_ACCESS_KEY=
S3_SECRET_KEY=
GARAGE_RPC_SECRET=

# --- Stripe (plano Pro) ---
# Sempre as chaves de TESTE (sk_test_...), do painel do Stripe em modo de teste.
#   STRIPE_SECRET_KEY:     Developers -> API keys -> Secret key
#   STRIPE_PRICE_ID:       id do preço mensal do plano Pro (price_...)
#   STRIPE_WEBHOOK_SECRET: segredo do endpoint de webhook (whsec_...); rodando
#                          local, é o que o "stripe listen" mostra
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=

# credenciais SMTP (Mailtrap em dev, Brevo em produção)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=no-reply@talhaoemdia.local
